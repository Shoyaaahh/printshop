# Copy this file to ".env" and edit. Never commit .env.
APP_DEBUG=0
APP_TIMEZONE=Asia/Manila
MAX_UPLOAD_MB=20

# Optional: move data somewhere else (defaults shown)
# DB_PATH=storage/printshop.sqlite
# STORAGE_DIR=storage

# Python command: "python3" on Mac/Linux, "python" on Windows
PYTHON_BIN=python

# Email notifications (optional). Also tick the option in Admin > Settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
